# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mace_festhub?retryWrites=true&w=majority

# Server port
PORT=3000

# JWT secret (change to a long random string in production)
JWT_SECRET=your_jwt_secret_here

# ── Email (Nodemailer + Gmail) ────────────────────────────────────────────────
# Without these, emails are logged to the console instead of actually sent.
# Setup:
#   1. Enable 2-Step Verification on the Gmail account you want to send from
#   2. Go to: myaccount.google.com → Security → App passwords
#   3. Create an "App password" for "Mail" (select Windows/Mac/Linux)
#   4. Copy the 16-character password and paste it below (spaces don't matter)
GMAIL_USER=your.college.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Public URL of your app (used in email links and QR codes)
# For local development: http://localhost:3000
# For production: https://yourdomain.com
APP_URL=http://localhost:3000

# ── Principal Account ─────────────────────────────────────────────────────────
PRINCIPAL_EMAIL=principal@mace.ac.in
PRINCIPAL_PASSWORD=principal2026
PRINCIPAL_NAME=Principal
