# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mace_festhub?retryWrites=true&w=majority

# Server port
PORT=3000

# JWT secret (change to a long random string in production)
JWT_SECRET=your_jwt_secret_here

# ── Email (Nodemailer + Gmail) ────────────────────────────────────────────────
# Without these, emails are logged to the console instead of actually sent.
# Setup:
#   1. Enable 2-Step Verification on the Gmail account you want to send from
#   2. Go to: myaccount.google.com → Security → App passwords
#   3. Create an "App password" for "Mail" (select Windows/Mac/Linux)
#   4. Copy the 16-character password and paste it below (spaces don't matter)
GMAIL_USER=your.college.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Public URL of your app (used in email links and QR codes)
# For local development: http://localhost:3000
# For production: https://yourdomain.com
APP_URL=http://localhost:3000

# ── Principal Account ─────────────────────────────────────────────────────────
PRINCIPAL_EMAIL=principal@mace.ac.in
PRINCIPAL_PASSWORD=principal2026
PRINCIPAL_NAME=Principal

# ── Google OAuth & Calendar ───────────────────────────────────────────────────
# Required for "Continue with Google" and automatic Calendar syncing.
# Setup:
#   1. Go to https://console.cloud.google.com
#   2. Create a project and enable the "Google Calendar API"
#   3. Go to "Credentials" -> Create OAuth client ID (Web application)
#   4. Add Authorized redirect URI: http://localhost:3000/api/auth/google/callback
#   5. Copy the Client ID and Client Secret here:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Razorpay Test Credentials ──────────────────────────────────────────────────
# Required for testing the Mock Payment Gateway flow on paid events.
# Setup:
#   1. Go to https://dashboard.razorpay.com/ and create a free account
#   2. Ensure you are in "Test Mode" (toggle at the top or side bar)
#   3. Go to "Account & Settings" -> "API Keys"
#   4. Click "Generate Test Key"
#   5. Copy the Key Id and Key Secret here:
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
